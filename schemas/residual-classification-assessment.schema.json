{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/inferential-regenerative-cycle-protocol/v0.3.0/residual-classification-assessment.schema.json",
  "title": "Residual Classification Assessment",
  "description": "Classifies an inference residual as recoverable, dormant, hazardous, or discardable and records the evidence and controls supporting that decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "assessment_id",
    "residual_id",
    "source_inference_id",
    "assessed_at",
    "assessor",
    "classification",
    "confidence",
    "rationale",
    "evidence_refs",
    "risk_evaluation",
    "decision",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "record_type": {"const": "residual_classification_assessment"},
    "assessment_id": {
      "type": "string",
      "pattern": "^assessment:[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
    },
    "residual_id": {
      "type": "string",
      "pattern": "^residual:[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
    },
    "source_inference_id": {
      "type": "string",
      "pattern": "^inference:[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
    },
    "assessed_at": {"type": "string", "format": "date-time"},
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessor_id", "assessor_type", "independence"],
      "properties": {
        "assessor_id": {
          "type": "string",
          "pattern": "^(agent|service|human):[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
        },
        "assessor_type": {
          "type": "string",
          "enum": ["ai_agent", "assessment_service", "human_reviewer"]
        },
        "independence": {
          "type": "string",
          "enum": ["same_runtime", "separate_runtime", "separate_operator"]
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^authorization:[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["recoverable", "dormant", "hazardous", "discardable"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 4000},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(trace|artifact|audit|metric):[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
      }
    },
    "risk_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hazard_level",
        "contamination_risk",
        "provenance_status",
        "integrity_status",
        "policy_compatibility"
      ],
      "properties": {
        "hazard_level": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "critical"]
        },
        "contamination_risk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "critical"]
        },
        "provenance_status": {
          "type": "string",
          "enum": ["verified", "partial", "missing", "conflicted"]
        },
        "integrity_status": {
          "type": "string",
          "enum": ["verified", "unverified", "mismatch"]
        },
        "policy_compatibility": {
          "type": "string",
          "enum": ["compatible", "conditional", "incompatible", "unknown"]
        },
        "risk_notes": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "candidate_reuse_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_type", "target_id", "reuse_mode"],
        "properties": {
          "target_type": {
            "type": "string",
            "enum": [
              "future_inference_context",
              "retrieval_cache",
              "safety_policy",
              "boundary_condition_registry",
              "agent_handoff",
              "model_routing_policy",
              "physical_recovery_system",
              "royalty_pool"
            ]
          },
          "target_id": {"type": "string", "minLength": 3, "maxLength": 256},
          "reuse_mode": {
            "type": "string",
            "enum": [
              "contextual_reference",
              "cache_seed",
              "constraint",
              "training_evidence",
              "operational_input",
              "thermal_recovery",
              "economic_reallocation"
            ]
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_for_reintegration_planning",
        "required_action",
        "human_review_required"
      ],
      "properties": {
        "eligible_for_reintegration_planning": {"type": "boolean"},
        "required_action": {
          "type": "string",
          "enum": ["approve_for_planning", "retain_dormant", "quarantine", "discard"]
        },
        "human_review_required": {"type": "boolean"},
        "reuse_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 500}
        },
        "quarantine_reason": {"type": "string", "minLength": 10, "maxLength": 2000},
        "discard_reason": {"type": "string", "minLength": 10, "maxLength": 2000}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "awaiting_review", "quarantined", "awaiting_disposal", "closed"]
        },
        "review_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "supersedes_assessment_id": {
          "type": "string",
          "pattern": "^assessment:[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^x-[A-Za-z0-9._-]+$"},
      "additionalProperties": true
    }
  }
}
